{
  "name": "memory-relay",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "wrangler dev --local",
    "build:local": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "build": "npm run sync:anthropic && vite build",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --experimental-sqlite --test test/*.test.js",
    "test:core": "node --experimental-sqlite --test test/anthropic-adaptations.test.js test/hardening.test.js test/skills.test.js test/worker.test.js test/sync-official-generator.test.js test/upstream-import.test.js test/skill-cleanup.test.js test/github-repo-sync.test.js test/monitoring.test.js test/workspace-ui.test.js test/saved-model-catalog.test.js",
    "sync:anthropic": "node scripts/sync-anthropic.mjs",
    "dev:live": "MEMORYRELAY_DEV_BACKEND=https://memoryrelay.zouhairelayni.workers.dev vite --host 127.0.0.1",
    "preview:live": "MEMORYRELAY_DEV_BACKEND=https://memoryrelay.zouhairelayni.workers.dev vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "chart.js": "^4.6.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "vite": "^6.3.5",
    "wrangler": "^4.0.0"
  }
}
